# E2E Test Configuration
# Copy to .env and fill in values

# Strapi backend URL (default: http://localhost:1337)
E2E_BACKEND_URL=http://localhost:1337

# React frontend URL (default: http://localhost:3000)
E2E_FRONTEND_URL=http://localhost:3000

# E2E test user credentials (created automatically by global setup)
E2E_USER_EMAIL=e2e@test.local
E2E_USER_PASSWORD=E2eTest1234!
E2E_USER_NAME=e2euser
